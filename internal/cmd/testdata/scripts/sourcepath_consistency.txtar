mkhomedir
mksourcedir

# Test 1: apply --source-path with single file
exec chezmoi apply --source-path --force $CHEZMOISOURCEDIR/dot_file
exists $HOME/.file
cmp $HOME/.file $CHEZMOISOURCEDIR/dot_file

# Test 2: apply without --source-path (target path mode) gives same result
exec rm $HOME/.file
exec chezmoi apply --force $HOME${/}.file
exists $HOME/.file
cmp $HOME/.file $CHEZMOISOURCEDIR/dot_file

# Test 3: apply --source-path with directory and recursive
exec rm -rf $HOME/.dir
exec chezmoi apply --source-path --force --recursive $CHEZMOISOURCEDIR/dot_dir
exists $HOME/.dir
exists $HOME/.dir/file

# Test 4: re-add --source-path
cp $CHEZMOISOURCEDIR/dot_dir/file $HOME/.file
exec chezmoi re-add --source-path $CHEZMOISOURCEDIR/dot_file
cmp $CHEZMOISOURCEDIR/dot_file $CHEZMOISOURCEDIR/dot_dir/file

# Test 5: parent directory traversal protection
! exec chezmoi apply --source-path --force $CHEZMOISOURCEDIR/../etc/passwd
stderr 'not in'

# Test 6: target-path command consistency
exec chezmoi target-path $CHEZMOISOURCEDIR/dot_file
stdout ^${HOME@R}/\.file$

# Test 7: source-path command consistency
exec chezmoi source-path $HOME/.file
stdout ^${CHEZMOISOURCEDIR@R}/dot_file$

# Test 8: add --source-path works
# (source path for an existing file should not error)
exec chezmoi add --source-path $CHEZMOISOURCEDIR/dot_file
exists $CHEZMOISOURCEDIR/dot_file

-- home/user/.local/share/chezmoi/dot_file --
# contents of .file
-- home/user/.local/share/chezmoi/dot_dir/file --
# contents of .dir/file
