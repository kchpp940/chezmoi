[unix] chmod 755 bin/secret
[windows] unix2dos bin/secret.cmd

# test secret template function with default config
exec chezmoi execute-template '{{ secret "password" }}'
stdout ^password$

# test secret template function with args from config
chhome home2/user
exec chezmoi execute-template '{{ secret "password" }}'
stdout '^prod password$'

# switch to different config - cache should not leak
chhome home3/user
exec chezmoi execute-template '{{ secret "password" }}'
stdout '^staging password$'

-- bin/secret --
#!/bin/sh

echo "$*"
-- bin/secret.cmd --
@echo off
setlocal
set out=%*
set out=%out:\=%
echo %out%
endlocal
-- home/user/.config/chezmoi/chezmoi.toml --
[secret]
    command = "secret"
-- home2/user/.config/chezmoi/chezmoi.toml --
[secret]
    command = "secret"
    args = ["prod"]
-- home3/user/.config/chezmoi/chezmoi.toml --
[secret]
    command = "secret"
    args = ["staging"]
